# Supabase project settings (Project Settings -> API in the Supabase dashboard,
# or `supabase status` if running locally via `supabase start`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-SIDE ONLY, never prefix with NEXT_PUBLIC_.
# Used only by lib/supabase/admin.ts and scripts/create-first-admin.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL this app is served at (used to build the invite email's redirect link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
